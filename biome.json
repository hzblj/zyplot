{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"extends": ["@hzblj/biome-config/react"],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": ["**", "!!**/build", "!!**/dist", "!!**/.next"]
	},
	"overrides": [
		{
			"includes": ["packages/platform-web/src/chart/**/*-skeleton.tsx"],
			"linter": {
				"rules": {
					"suspicious": {
						"noArrayIndexKey": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/platform-web/src/chart/meter/meter-bar.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off"
					}
				}
			}
		}
	]
}
