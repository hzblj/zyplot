{
	"name": "zyplot-monorepo",
	"version": "0.0.0",
	"private": true,
	"packageManager": "yarn@4.17.1",
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo build",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"dev": "turbo dev",
		"dev:example": "yarn workspace @zyplot/example start",
		"dev:website": "yarn workspace @zyplot/website dev",
		"lint": "turbo lint",
		"lint:fix": "turbo lint:fix",
		"release": "turbo build lint && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@changesets/changelog-github": "0.7.0",
		"@changesets/cli": "2.31.1",
		"@types/node": "^25.0.0",
		"turbo": "2.10.7",
		"typescript": "^5.9.3"
	},
	"resolutions": {
		"react": "19.2.0",
		"react-dom": "19.2.0"
	}
}
