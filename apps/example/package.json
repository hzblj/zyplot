{
	"name": "@zyplot/example",
	"private": true,
	"version": "0.0.3",
	"main": "expo-router/entry",
	"scripts": {
		"android": "expo run:android",
		"build": "tsc --noEmit",
		"dev": "expo start --dev-client",
		"dev:android": "expo prebuild --clean --platform android && expo run:android",
		"dev:ios": "expo prebuild --clean --platform ios && expo run:ios",
		"ios": "expo run:ios",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prebuild": "expo prebuild --clean",
		"start": "expo start --dev-client",
		"web": "expo start --web"
	},
	"dependencies": {
		"@expo/log-box": "55.0.13",
		"@expo/ui": "^55.0.17",
		"@hzblj/zyplot": "workspace:*",
		"expo": "55.0.28",
		"expo-build-properties": "~55.0.9",
		"expo-constants": "~55.0.17",
		"expo-linking": "~55.0.16",
		"expo-router": "55.0.17",
		"expo-status-bar": "55.0.6",
		"expo-system-ui": "~55.0.20",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-native": "0.83.10",
		"react-native-pager-view": "8.0.0",
		"react-native-safe-area-context": "~5.6.2",
		"react-native-screens": "~4.23.0",
		"react-native-web": "0.21.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@hzblj/biome-config": "^0.2.0",
		"@types/react": "^19.2.0",
		"typescript": "^5.9.3"
	}
}
