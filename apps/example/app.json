{
	"expo": {
		"name": "Zyplot Example",
		"slug": "zyplot-example",
		"scheme": "zyplot-example",
		"version": "0.0.0",
		"orientation": "portrait",
		"userInterfaceStyle": "automatic",
		"ios": {
			"bundleIdentifier": "com.hzblj.zyplot.example",
			"supportsTablet": true
		},
		"android": {
			"package": "com.hzblj.zyplot.example"
		},
		"plugins": [
			"expo-router",
			[
				"expo-build-properties",
				{
					"ios": {
						"deploymentTarget": "17.0"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		}
	}
}
