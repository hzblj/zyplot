{
	"name": "@hzblj/zyplot",
	"version": "0.5.0",
	"description": "Native-feeling cross-platform charts for React and Expo.",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"react-native": "./build/index.native.js",
	"exports": {
		".": {
			"react-native": {
				"types": "./build/index.native.d.ts",
				"default": "./build/index.native.js"
			},
			"types": "./build/index.d.ts",
			"import": "./build/index.js"
		},
		"./web": {
			"types": "./build/web/index.d.ts",
			"import": "./build/web/index.js"
		},
		"./ios": {
			"types": "./build/ios/index.d.ts",
			"import": "./build/ios/index.js"
		},
		"./android": {
			"types": "./build/android/index.d.ts",
			"import": "./build/android/index.js"
		},
		"./style.css": "./style.css",
		"./expo-module.config.json": "./expo-module.config.json",
		"./package.json": "./package.json"
	},
	"files": [
		"android",
		"build",
		"expo-module.config.json",
		"ios",
		"style.css"
	],
	"sideEffects": [
		"*.css",
		"./build/web/**"
	],
	"keywords": [
		"charts",
		"echarts",
		"expo",
		"jetpack-compose",
		"react",
		"react-native",
		"swift-charts",
		"uplot"
	],
	"homepage": "https://www.zyplot.janblazej.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hzblj/zyplot.git",
		"directory": "packages/zyplot"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && tailwindcss -i src/web/chart.css -o build/charts.css --minify && node scripts/layer-styles.mjs build/charts.css",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@hzblj/zyplot-core": "workspace:*",
		"echarts": "^6.1.0",
		"tailwind-variants": "^3.2.2",
		"uplot": "1.6.32"
	},
	"peerDependencies": {
		"expo": ">=55",
		"react": ">=19",
		"react-native": ">=0.83"
	},
	"peerDependenciesMeta": {
		"expo": {
			"optional": true
		},
		"react-native": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@hzblj/biome-config": "^0.2.0",
		"@tailwindcss/cli": "^4.3.2",
		"@types/react": "^19.2.0",
		"@zyplot/core-tailwind-config": "workspace:*",
		"expo": "55.0.28",
		"react": "19.2.0",
		"react-native": "0.83.10",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"license": "MIT"
}
