{
	"name": "@hzblj/zyplot-platform-android",
	"version": "0.0.0",
	"description": "Jetpack Compose Expo Module renderer for Zyplot.",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"import": "./build/index.js"
		}
	},
	"files": [
		"android",
		"build",
		"expo-module.config.json"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@hzblj/zyplot-core": "workspace:*",
		"expo-modules-core": "55.0.25"
	},
	"peerDependencies": {
		"expo": ">=55",
		"react": ">=19",
		"react-native": ">=0.83"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@hzblj/biome-config": "^0.2.0",
		"@types/react": "^19.2.0",
		"expo": "55.0.28",
		"react": "19.2.0",
		"react-native": "0.83.6",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"license": "MIT"
}
