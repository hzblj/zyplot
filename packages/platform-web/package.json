{
	"name": "@hzblj/zyplot-platform-web",
	"version": "0.0.0",
	"description": "uPlot web renderer for Zyplot.",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"import": "./build/index.js"
		},
		"./style.css": "./style.css"
	},
	"files": [
		"build",
		"style.css"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@hzblj/zyplot-core": "workspace:*",
		"uplot": "1.6.32"
	},
	"peerDependencies": {
		"react": ">=19"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@hzblj/biome-config": "^0.2.0",
		"@types/react": "^19.2.0",
		"react": "19.2.0",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"license": "MIT"
}
