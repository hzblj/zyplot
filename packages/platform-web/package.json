{
	"name": "@hzblj/zyplot-platform-web",
	"version": "0.0.0",
	"description": "ECharts and uPlot web chart library for Zyplot.",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"import": "./build/index.js"
		},
		"./style.css": "./style.css"
	},
	"files": [
		"build",
		"style.css"
	],
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"build": "tsup && tailwindcss -i src/chart.css -o build/charts.css --minify",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"echarts": "^6.1.0",
		"tailwind-variants": "^3.2.2",
		"uplot": "1.6.32"
	},
	"peerDependencies": {
		"react": ">=19"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@hzblj/biome-config": "^0.2.0",
		"@tailwindcss/cli": "^4.3.2",
		"@types/react": "^19.2.0",
		"@zyplot/core-tailwind-config": "workspace:*",
		"react": "19.2.0",
		"tsup": "8.5.1",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"license": "MIT"
}
